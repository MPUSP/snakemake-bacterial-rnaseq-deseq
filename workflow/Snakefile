# load configuration
# -----------------------------------------------------
configfile: "config/config.yml"


# load rules
# -----------------------------------------------------
include: "rules/common.smk"
include: "rules/deseq2.smk"


# container definition (optional)
container: "oras://ghcr.io/mpusp/snakemake-bacterial-rnaseq-deseq:latest"


module rnaseq_processing:
    snakefile:
        github(
            "MPUSP/snakemake-bacterial-rnaseq-processing",
            path="workflow/Snakefile",
            branch="main",
        )
    config:
        config


use rule * from rnaseq_processing as process_*


# optional messages, log and error handling
# -----------------------------------------------------
onstart:
    print("\n--- Analysis started ---\n")


onsuccess:
    print("\n--- Workflow finished! ---\n")


onerror:
    print("\n--- An error occurred! ---\n")


# target rules
# -----------------------------------------------------
rule all:
    default_target: True
    input:
        "results/multiqc/multiqc_report.html",
        "results/deseq2/counts_report.html",
        "results/deseq2/deseq2_report.html",
